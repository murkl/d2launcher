#!/usr/bin/env bash
# D2Launcher: Median XL for Diablo II on Linux, through Wine. It keeps Median XL
# up to date, starts D2Stats and tweaks, and backs up the game and savegames.
# docs/REFERENCE.md describes the settings and what lives in ~/.d2launcher.

# Stamped by `make dist` for a release.
VERSION='{{VERSION}}'

# Kron4ek's build of Proton's Wine in its WoW64 form: it runs the 32-bit game
# without a 32-bit library of the system, the same on every distribution. A
# bundled Wine that reports another version is replaced by this one.
WINE_URL='https://github.com/Kron4ek/Wine-Builds/releases/download/proton-11.0-2/wine-proton-11.0-2-amd64-wow64.tar.xz'
WINE_SHA256='f166f7daa1a37b3c8e0ade213a6e7915e582091804071a58a4a32c6c672e1595'
WINE_VERSION='wine-11.0-gdc26e618470 (Proton)'
# cnc-ddraw, which Median XL brings, loads as on Windows: before Wine's own ddraw.
# Windows programs get no menu entries or file types in the desktop.
WINE_OVERRIDES='ddraw=n,b;winemenubuilder.exe=d'
# The newest on purpose: a Median XL update can need a new D2Stats the same day.
D2STATS_URL='https://github.com/azadix/D2Stats/releases/latest/download/D2Stats.zip'
SIGMA_LOADER_URL='https://github.com/SyndromeDayna/diablo-2-median-xl-sigma-loader/releases/latest/download/sigma-loader.exe'
MXL_URL='https://launcher.median-xl.com/mxl/release/{channel}/manifest'
RELEASE_URL='https://api.github.com/repos/murkl/d2launcher/releases/latest'
DOCS_URL='https://github.com/murkl/d2launcher/blob/main/docs/REFERENCE.md'

REQUIRES=(zenity curl jq unzip zip tar xz sha1sum sha256sum flock pgrep)
# Without every MPQ of a full installation, Diablo II asks for its disc.
MPQS=(d2char d2data d2exp d2music d2sfx d2speech d2video d2xmusic d2xtalk d2xvideo)
# Each file of a Median XL version as sha1sum lists it: 40 hex digits, two
# spaces, a plain file name. A name never leads out of the game folder.
SUM_LINE='^[0-9a-f]{40}  [A-Za-z0-9][A-Za-z0-9._ -]*$'

# --- Places and settings

# Where everything lives. A function, so the tests set HOME first.
places() {
    dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
    home="${HOME}/.d2launcher"
    conf="${home}/d2launcher.conf"
    logs="${home}/logs"
    logfile="${logs}/d2launcher.log"
    game="${home}/bin/diablo2"
    wine_home="${home}/bin/wine"
    stats="${home}/bin/d2-stats"
    patches="${home}/patches"
    user_tweaks="${home}/tweaks"
    backups="${home}/backup"
    cache="${XDG_CACHE_HOME:-${HOME}/.cache}/d2launcher"
    icon="${dir}/d2launcher.svg"
}

# The settings at their defaults. docs/REFERENCE.md#settings explains them.
defaults() {
    launch_options='-3dfx'
    channel='public'
    wine="${wine_home}/bin/wine"
    prefix="${home}/wineprefix"
    median_xl=true
    d2stats=false
}

# What a first start writes: every setting at its default.
settings_template() {
    cat <<'EOF'
# D2Launcher settings, each at its default. Change a value to change the setting.
# https://github.com/murkl/d2launcher/blob/main/docs/REFERENCE.md#settings

# The command line of Diablo II, as in Steam: arguments, or a command around %command%.
launch_options=-3dfx

# The Median XL channel, public or beta.
channel=public

# A Wine of your own, such as /usr/bin/wine. Empty for the bundled one.
wine=

# The Wine prefix.
prefix=~/.d2launcher/wineprefix

# Median XL on top of Diablo II. Off, Play starts Diablo II alone, from a folder of its own.
median_xl=true

# D2Stats beside Median XL: Play starts it first, then the game through sigma-loader.
d2stats=false
EOF
}

# Reads a settings file over the current values and prints what is wrong with
# it. Each value is checked here, so a mistake shows at the start, with its line.
read_settings() {
    local n=0 line key value program
    while IFS= read -r line || [[ -n $line ]]; do
        n=$((n + 1))
        [[ ! $line =~ ^[[:space:]]*(#|$) ]] || continue
        if [[ ! $line =~ ^[[:space:]]*([A-Za-z0-9_]+)=(.*)$ ]]; then
            echo "Line ${n} is no setting=value."
            return 1
        fi
        key="${BASH_REMATCH[1]}"
        value="${BASH_REMATCH[2]}"
        value="${value%"${value##*[![:space:]]}"}"
        [[ ! $value =~ ^\"(.*)\"$ ]] || value="${BASH_REMATCH[1]}"
        [[ $value != \~/* ]] || value="${HOME}/${value#\~/}"
        case $key in
        launch_options)
            case $value in
            *[\;\&\|\<\>\$\`\\\(\)\{\}\"\']*)
                echo "Line ${n}: launch_options runs without a shell. Leave out ; & | < > \$ \` \\ ( ) { } and quotes."
                return 1
                ;;
            esac
            program="$(launch_program "$value")"
            if [[ -n $program ]] && ! command -v "$program" >/dev/null; then
                echo "Line ${n}: launch_options runs ${program}, which is not installed."
                return 1
            fi
            launch_options="$value"
            ;;
        channel)
            if [[ $value != public && $value != beta ]]; then
                echo "Line ${n}: channel is public or beta."
                return 1
            fi
            channel="$value"
            ;;
        wine)
            if [[ -n $value ]] && ! command -v "$value" >/dev/null; then
                echo "Line ${n}: wine names no program: ${value}"
                return 1
            fi
            wine="${value:-${wine_home}/bin/wine}"
            ;;
        prefix)
            if [[ -n $value && $value != /* ]]; then
                echo "Line ${n}: prefix is an absolute path, such as ~/Games/diablo2."
                return 1
            fi
            prefix="${value:-${home}/wineprefix}"
            ;;
        median_xl | d2stats)
            if [[ $value != true && $value != false ]]; then
                echo "Line ${n}: ${key} is true or false."
                return 1
            fi
            printf -v "$key" '%s' "$value"
            ;;
        *)
            echo "Line ${n}: there is no setting ${key}. They are launch_options, channel, wine, prefix, median_xl and d2stats."
            return 1
            ;;
        esac
    done <"$1"
    if [[ $d2stats == true && $median_xl == false ]]; then
        echo 'd2stats reads Median XL and needs median_xl=true.'
        return 1
    fi
}

# The program launch options run the game with: the first word in front of
# %command% that sets no variable. Empty when they only pass arguments.
launch_program() {
    local words word
    [[ " $1 " == *' %command% '* ]] || return 0
    read -ra words <<<"$1"
    for word in "${words[@]}"; do
        [[ $word =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || break
    done
    [[ $word == '%command%' ]] || printf '%s' "${word/#\~\//${HOME}/}"
}

# The settings of ~/.d2launcher/d2launcher.conf. A mistake opens the editor.
load_settings() {
    local problem
    if [[ ! -f $conf ]]; then
        settings_template >"${conf}.part"
        mv -f "${conf}.part" "$conf"
    fi
    while ! problem="$(defaults && read_settings "$conf")"; do
        ui_error "$(esc "${conf}"): $(esc "$problem")"
        edit_settings || exit 1
    done
    use_settings
}

# The settings of the file in force, and the game folder they choose.
use_settings() {
    defaults
    read_settings "$conf" >/dev/null
    game="${game%-vanilla}"
    [[ $median_xl == true ]] || game+='-vanilla'
}

# The settings in an editor. What you save is checked first, and a mistake opens
# the editor again with your text.
edit_settings() {
    local text problem draft="${run}/settings"
    cp "$conf" "$draft"
    while true; do
        text="$(ui_text Configuration --editable --filename="$draft" --ok-label=Save --cancel-label=Cancel)" || return 1
        printf '%s\n' "$text" >"$draft"
        problem="$(defaults && read_settings "$draft")" && break
        ui_error "$(esc "$problem")"
    done
    cp "$draft" "${conf}.part"
    mv -f "${conf}.part" "$conf"
    use_settings
    notify 'Settings saved.'
}

# --- Log

# A line of the log: the time, where it comes from, what happened. The sources
# are launcher, wine, game, d2stats and tweak.
log() {
    printf '%(%F %T)T  %-8s  %s\n' -1 "${2:-launcher}" "$1" >>"$logfile"
}

# Every line of a stream into the log, under the source named.
log_stream() {
    local line
    while IFS= read -r line; do
        log "$line" "$1"
    done
}

log_hint() {
    printf 'The log has the details:\n%s' "$(esc "$logfile")"
}

# Each start writes a log of its own. The four before it stay as .1 to .4 and
# the oldest goes. 4.x kept its log beside the settings, the one before in backup/.
rotate_logs() {
    local n
    mkdir -p "$logs"
    [[ ! -f ${backups}/d2launcher.log.old ]] || mv -f "${backups}/d2launcher.log.old" "${logfile}.1"
    [[ ! -f ${home}/d2launcher.log ]] || mv -f "${home}/d2launcher.log" "$logfile"
    for n in 3 2 1; do
        [[ ! -f ${logfile}.${n} ]] || mv -f "${logfile}.${n}" "${logfile}.$((n + 1))"
    done
    [[ ! -f $logfile ]] || mv -f "$logfile" "${logfile}.1"
}

# What a report needs first: the versions and the system.
log_system() {
    local os
    os="$(sed -n 's/^PRETTY_NAME="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/os-release 2>/dev/null)" || true
    log "D2Launcher $(version) on ${os:-an unknown system}, kernel $(uname -r), zenity $(zenity --version 2>/dev/null)"
}

# --- Interface

# zenity in the launcher's look, run under the name d2launcher. zenity hands its
# name to the desktop as the app id of its windows, so they go with the menu
# entry and other zenity windows keep their own icon. zenity 4 shows the icon
# in a dialog, older versions have no option for it.
ui() {
    (exec -a d2launcher zenity --title='' "${icon_option[@]}" "$@")
}

ui_info() {
    ui --info --width=360 --text="$1" "${@:2}" || true
}

ui_error() {
    ui --error --width=360 --text="$1" "${@:2}" || true
}

ui_ask() {
    ui --question --width=360 --text="$1" "${@:2}"
}

# A text in a window of its own, monospaced and titled as the list it came from:
# the settings and the script of a tweak.
ui_text() {
    ui --text-info --title="$1" --width=960 --height=680 --font=monospace "${@:2}"
}

# A list under the versions, its title over the first column, at the size of 4.x.
ui_list() {
    ui --list --width=450 --height=420 --text="$(header)\n" --column="$1" "${@:2}"
}

# A menu. Prints the line chosen, or ? for the help button, and logs it.
ui_menu() {
    local title="$1" back="$2" choice status=0
    shift 2
    choice="$(ui_list "$title" --ok-label=Ok --cancel-label="$back" --extra-button='?' "$@")" || status=$?
    log "${title}: ${choice:-${back}}"
    printf '%s' "$choice"
    return "$status"
}

# The versions above every list: monospace and bold as in 4.x, the launcher in
# a rust that light and dark themes both keep legible, Median XL and Wine in
# the text color a quarter lighter.
header() {
    local mxl=off
    [[ $median_xl == false ]] || mxl="$(installed_tag)"
    printf '<span font_family="monospace" font="9"><b><span foreground="#C8401A">D2LAUNCHER | %s</span>\n<span alpha="76%%">MEDIAN XL  | %s\nWINE       | %s</span></b></span>' \
        "$(esc "$(version)")" "$(esc "${mxl:-not installed}")" "$(esc "$(wine_name)")"
}

# Runs a command as a job behind a progress dialog and returns its status. The
# dialog opens after half a second, follows the job's "# text" lines, and Cancel
# stops the job with everything it started. What the job prints on stderr is in
# the log before it ends.
ui_progress() {
    local cancel=() text pid feed status=0 started=$SECONDS _
    if [[ $1 == --no-cancel ]]; then
        cancel=(--no-cancel)
        shift
    fi
    text="$1"
    shift
    log "${text}: started"
    feed="$(mktemp -p "$run")"
    set -m
    { "$@" 2>&1 >&3 | log_stream launcher; } 3>"$feed" </dev/null 9>&- &
    pid=$!
    set +m
    for _ in 1 2 3 4 5; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
        tail -s 0.2 -f --pid="$pid" "$feed" | {
            ui --progress --pulsate --auto-close --width=360 --text="$(esc "$text")" "${cancel[@]}" ||
                kill -- -"$pid" 2>/dev/null || true
        }
    fi
    rm -f "$feed"
    wait "$pid" || status=$?
    if ((status == 0)); then
        log "${text}: done in $((SECONDS - started)) s"
    else
        log "${text}: failed with status ${status}"
    fi
    return "$status"
}

# Text for the Pango markup of a zenity dialog, which reads \n as a new line.
esc() {
    local text="${1//\\/\\\\}"
    text="${text//&/\&amp;}"
    text="${text//</\&lt;}"
    printf '%s' "${text//>/\&gt;}"
}

# A desktop notification, in the log as well. zenity sends it in the background.
notify() {
    log "$1"
    ui --notification --text="$1" >/dev/null 2>&1 9>&- &
}

# The reference in the browser, or its address where no browser opens.
open_docs() {
    if command -v xdg-open >/dev/null; then
        xdg-open "$DOCS_URL" >/dev/null 2>&1 9>&- &
    else
        ui_info "The reference is at\n${DOCS_URL}"
    fi
}

# --- Wine

# The Wine in use as the header names it: the bundled one by its release, any
# other by the version it reports.
wine_name() {
    local name
    name="$("$wine" --version 2>/dev/null)" || name='not installed'
    if [[ $name == "$WINE_VERSION" ]]; then
        name="${WINE_URL#*/download/}"
        name="${name%%/*}"
        name="${name/-/ }"
        name="${name^}"
    fi
    printf '%s' "$name"
}

# A command with Wine as the launcher runs it: its prefix and WINE_OVERRIDES, no
# Wine variable of the shell it was started from, and no flood of fixme lines.
# What the launch options set comes after this and wins.
with_wine() {
    local name unset=()
    while IFS= read -r name; do
        [[ $name != WINE* ]] || unset+=(-u "$name")
    done < <(compgen -e)
    env "${unset[@]}" -- WINEPREFIX="$prefix" WINEDEBUG=fixme-all WINEDLLOVERRIDES="$WINE_OVERRIDES" "$@" 9>&-
}

# The prefix set up or updated, within five minutes. Wine Mono and Gecko stay
# out: their installers wait for a click in a window, and Median XL needs neither.
setup_prefix() {
    with_wine WINEDLLOVERRIDES="${WINE_OVERRIDES};mscoree=d;mshtml=d" timeout 300 "$wine" wineboot "$1" 2>&1 |
        log_stream wine
}

# A Wine program, its output in the log.
run_wine() {
    with_wine "$wine" "$@" 2>&1 | log_stream wine
}

# Wine, its prefix, and the save folder of Median XL. A bundled Wine of another
# version than WINE_VERSION is replaced. The savegames go into the backup folder
# first, then the new Wine updates the prefix.
ready_wine() {
    local installed=''
    if [[ $wine == "${wine_home}/bin/wine" ]]; then
        [[ ! -x $wine ]] || installed="$("$wine" --version 2>/dev/null)" || true
        if [[ $installed != "$WINE_VERSION" ]]; then
            if [[ -d $(saves) ]] && ! ui_progress 'Backing up the saves' zip_saves "$(saves_backup)"; then
                ui_error "The saves could not be backed up before the new Wine.\n\n$(log_hint)"
                return 1
            fi
            if ! ui_progress 'Downloading Wine' install_wine; then
                ui_error "Wine could not be installed.\n\n$(log_hint)"
                return 1
            fi
        fi
    fi
    if [[ ! -f ${prefix}/system.reg ]]; then
        if ! ui_progress --no-cancel 'Setting up Wine' setup_prefix --init; then
            with_wine "${wine%/*}/wineserver" -k || true
            ui_error "Wine could not set up its prefix.\n\n$(log_hint)"
            return 1
        fi
    elif [[ -n $installed && $installed != "$WINE_VERSION" ]] &&
        ! ui_progress --no-cancel 'Updating the Wine prefix' setup_prefix --update; then
        with_wine "${wine%/*}/wineserver" -k || true
        ui_error "Wine could not update its prefix.\n\n$(log_hint)"
        return 1
    fi
    if ! game_on_win7; then
        ui_error "Wine could not set the Windows version of the game.\n\n$(log_hint)"
        return 1
    fi
    log "Wine: $("$wine" --version 2>/dev/null) at ${wine}"
    # Median XL fails with "Generic bad character" until its save folder exists.
    [[ $median_xl == false ]] || mkdir -p "$(saves)/save"
}

# Diablo II 1.13, which Median XL builds on, asks for its disc on a Windows newer
# than 7. Game.exe alone sees Windows 7, the rest of the prefix keeps Wine's.
game_on_win7() {
    local key
    key="$(sed -n '/^\[Software\\\\Wine\\\\AppDefaults\\\\Game\.exe\]/,/^$/p' "${prefix}/user.reg")"
    [[ $key != *'"Version"="win7"'* ]] || return 0
    with_wine "$wine" reg add 'HKCU\Software\Wine\AppDefaults\Game.exe' /v Version /d win7 /f 2>&1 | log_stream wine
}

# The pinned Wine, checked against its sha256 and read back for its version.
install_wine() {
    local part="${wine_home}.part" tarball="${run}/wine.tar.xz"
    if [[ $(uname -m) != x86_64 ]]; then
        echo "The bundled Wine runs on x86_64, this is $(uname -m). Set wine to a Wine of your own." >&2
        return 1
    fi
    fetch -o "$tarball" "$WINE_URL"
    printf '%s  %s\n' "$WINE_SHA256" "$tarball" | LC_ALL=C sha256sum -c --quiet
    rm -rf "$part"
    mkdir -p "$part"
    tar -xJf "$tarball" -C "$part" --strip-components=1
    [[ "$("${part}/bin/wine" --version)" == "$WINE_VERSION" ]]
    rm -rf "$wine_home" "$tarball"
    mv "$part" "$wine_home"
}

# Where the game keeps the characters. Median XL keeps them in %APPDATA%,
# Diablo II 1.14 in Saved Games, both under the user the prefix's registry
# names: steamuser for Proton's Wine, the login for others. Diablo II before
# 1.14, which still has a D2Client.dll, keeps them in the game folder.
saves() {
    local user
    if [[ $median_xl == false && -f ${game}/D2Client.dll ]]; then
        printf '%s/save' "$game"
        return 0
    fi
    user="$(sed -n 's/^"AppData"="C:\\\\users\\\\\([^\\]*\)\\\\AppData\\\\Roaming"$/\1/p' "${prefix}/user.reg" 2>/dev/null)" || true
    if [[ $median_xl == true ]]; then
        printf '%s/drive_c/users/%s/AppData/Roaming/MedianXL' "$prefix" "${user:-${USER}}"
    else
        printf '%s/drive_c/users/%s/Saved Games/Diablo II' "$prefix" "${user:-${USER}}"
    fi
}

run_program() {
    local file
    ready_wine || return 0
    file="$(ui --file-selection --file-filter='Programs | *.exe *.msi')" || return 0
    run_wine start /unix "$file" || true
}

reinstall_wine() {
    if [[ $wine != "${wine_home}/bin/wine" ]]; then
        ui_info "D2Launcher runs your Wine, $(esc "$wine"). The bundled one is not in use."
        return 0
    fi
    ui_ask 'Download Wine again?' --ok-label=Download --cancel-label=Cancel || return 0
    if ! ui_progress 'Downloading Wine' install_wine; then
        ui_error "Wine could not be installed.\n\n$(log_hint)"
        return 0
    fi
    notify 'Wine is installed.'
}

# --- The game

# Everything a game needs, set up where it is missing: the game folder, Wine,
# Median XL when it is on, and D2GL for -3dfx with its start values.
ready() {
    ready_game && ready_wine && ready_mxl && ready_glide && seed_d2gl
}

# The game, once it is ready. With d2stats on, D2Stats starts first and the game
# through sigma-loader, which D2Stats reads it through. The launcher ends with
# the game.
start_game() {
    local exe='Diablo II.exe'
    ready || return 0
    if [[ $d2stats == true ]]; then
        ready_d2stats && ready_sigma_loader && start_d2stats || return 0
        exe='sigma-loader.exe'
    fi
    launch "$exe"
    exit 0
}

# The game in its folder, wrapped in the launch options as Steam does it:
# %command% stands for the game, without it the options are its arguments.
launch() {
    local command=("$wine" "$1") options argv=() token found=false
    read -ra options <<<"$launch_options"
    for token in "${options[@]}"; do
        [[ $token != \~/* ]] || token="${HOME}/${token#\~/}"
        if [[ $token == '%command%' ]]; then
            argv+=("${command[@]}")
            found=true
        else
            argv+=("$token")
        fi
    done
    "$found" || argv=("${command[@]}" "${argv[@]}")
    log "Starting ${argv[*]}"
    (cd "$game" && with_wine "${argv[@]}") 2>&1 | log_stream game || log "Diablo II ended with status $?"
}

# The game folder. A first start restores the backup or copies an installation.
ready_game() {
    [[ ! -d $game ]] || return 0
    if [[ -f $(game_backup) ]] &&
        ui_ask 'There is a backup of Diablo II. Restore it?' --ok-label=Restore --cancel-label='Choose a Folder'; then
        ui_progress --no-cancel 'Restoring Diablo II' restore_game && return 0
        ui_error "The backup could not be restored.\n\n$(log_hint)"
        return 1
    fi
    setup_game
}

# Opens on an installation it finds. What the copy, its backup, Wine and Median
# XL need is checked before anything is written.
setup_game() {
    local from found missing need free
    ui_info 'Choose the folder of your Diablo II installation with Lord of Destruction. D2Launcher copies it and sets up the rest.'
    found="$(find_game)"
    from="$(ui --file-selection --directory ${found:+"--filename=${found}/"})" || return 1
    from="${from%/}"
    if [[ ${home}/ == "${from}"/* ]]; then
        ui_error "$(esc "$from") holds D2Launcher itself. Choose the Diablo II folder."
        return 1
    fi
    if [[ -z $(find "$from" -maxdepth 1 -iname game.exe -print -quit) ]]; then
        ui_error "$(esc "$from") holds no Game.exe. Choose the Diablo II folder."
        return 1
    fi
    missing="$(missing_mpqs "$from")"
    if [[ -n $missing ]] && ! ui_ask "These files are missing: ${missing}\n\nWithout them Diablo II asks for its disc. Use the folder anyway?" \
        --ok-label='Use Anyway' --cancel-label=Back --default-cancel; then
        return 1
    fi
    # The copy and its backup take the folder twice, Wine with its prefix and
    # Median XL with its store about 3 GiB.
    need="$(du -sb "$from" | cut -f1)"
    need=$((need * 2 + 3 * 1024 ** 3))
    free="$(df --output=avail -B1 "$home" | tail -n 1)"
    if ((free < need)); then
        ui_error "Diablo II needs $(numfmt --to=iec-i "$need")B free in $(esc "$home"), there are $(numfmt --to=iec-i "$free")B."
        return 1
    fi
    if ! ui_progress 'Copying Diablo II' copy_game "$from"; then
        ui_error "Diablo II could not be copied.\n\n$(log_hint)"
        return 1
    fi
    ui_progress 'Backing up Diablo II' backup_game || ui_error "The backup failed.\n\n$(log_hint)"
    notify 'Diablo II is set up.'
}

# A folder that holds Diablo II where Wine, Lutris, Bottles, Steam or a mounted
# disk put it, within five seconds. Empty for none.
find_game() {
    local data="${XDG_DATA_HOME:-${HOME}/.local/share}" root roots=() found
    for root in "${HOME}/.wine" "${HOME}/Games" "${data}/bottles" "${data}/Steam/steamapps/compatdata" /run/media /media \
        "${HOME}/Downloads"; do
        [[ ! -d $root ]] || roots+=("$root")
    done
    ((${#roots[@]})) || return 0
    found="$(timeout 5 find "${roots[@]}" -maxdepth 8 -iname d2exp.mpq -print -quit 2>/dev/null)" || true
    [[ -z $found ]] || printf '%s' "${found%/*}"
}

missing_mpqs() {
    local mpq file present=' '
    for file in "$1"/*; do
        file="${file##*/}"
        present+="${file,,} "
    done
    for mpq in "${MPQS[@]}"; do
        [[ $present == *" ${mpq}.mpq "* ]] || printf '%s.mpq ' "$mpq"
    done
}

copy_game() {
    rm -rf "${game}.part"
    mkdir -p "${game%/*}"
    cp -r --reflink=auto "$1" "${game}.part"
    mv "${game}.part" "$game"
}

# D2GL for -3dfx where the game folder lacks a Glide wrapper. Median XL brings
# one, Diablo II alone does not. Your tweak d2gl wins, as in the Tweaks menu.
ready_glide() {
    local tweak="${user_tweaks}/d2gl.sh"
    [[ " ${launch_options} " == *' -3dfx '* && ! -f ${game}/glide3x.dll ]] || return 0
    [[ -f $tweak ]] || tweak="${dir}/tweaks/d2gl.sh"
    run_tweak D2GL "$tweak" && return 0
    ui_error "D2GL could not be installed.\n\n$(log_hint)"
    return 1
}

# Start values for a D2GL without settings: sharp upscaling and smooth motion,
# the colors left as Blizzard made them. Each start D2GL reads its d2gl.ini and
# writes it back whole, its own defaults filled in.
seed_d2gl() {
    [[ -f ${game}/d2gl.mpq && ! -f ${game}/d2gl.ini ]] || return 0
    cat >"${game}/d2gl.ini.part" <<'EOF'
[Screen]
fullscreen=true
[Graphic]
shader_preset=xbr\xbr-lv2-sharp.slangp
sharpen=true
fxaa=true
fxaa_preset=2
[Feature]
hd_cursor=true
motion_prediction=true
skip_intro=true
EOF
    mv -f "${game}/d2gl.ini.part" "${game}/d2gl.ini"
    log "D2GL: start values in ${game}/d2gl.ini"
}

# --- Median XL

# The installed Median XL, empty for none. 4.x wrote the name of its zip there,
# d2launcher-mxl-2.14.6.
installed_tag() {
    local tag=''
    [[ ! -f ${game}/d2launcher-patch.version ]] || tag="$(<"${game}/d2launcher-patch.version")"
    printf '%s' "${tag#d2launcher-mxl-}"
}

# Before a game, the newest Median XL of the channel, unless you play the one you
# have. The first one installs without a question. Without the server, the one
# you have starts.
ready_mxl() {
    local latest installed
    [[ $median_xl == true ]] || return 0
    installed="$(installed_tag)"
    if ! ui_progress 'Checking for Median XL updates' fetch_manifest; then
        [[ -z $installed ]] || return 0
        ui_error "Median XL is not installed, and its server is out of reach.\n\n$(log_hint)"
        return 1
    fi
    latest="$(jq -r .tag "${run}/manifest.json")"
    [[ $latest != "$installed" ]] || return 0
    if [[ -n $installed ]] &&
        ! ui_ask "Median XL ${latest} is available." --ok-label=Update --cancel-label="Play ${installed}"; then
        return 0
    fi
    update_mxl "$latest"
}

check_mxl() {
    local latest installed
    ready_game || return 0
    if ! ui_progress 'Checking for Median XL updates' fetch_manifest; then
        ui_error "The Median XL server is out of reach.\n\n$(log_hint)"
        return 0
    fi
    latest="$(jq -r .tag "${run}/manifest.json")"
    installed="$(installed_tag)"
    if [[ $latest == "$installed" ]]; then
        ui_info "Median XL ${installed} is up to date."
    elif ui_ask "Median XL ${latest} is available." --ok-label=Update --cancel-label=Later; then
        update_mxl "$latest" || true
    fi
}

# The manifest of the channel, checked before anything reads it.
fetch_manifest() {
    local manifest="${run}/manifest.json"
    fetch --max-time 30 -o "${manifest}.part" "${MXL_URL/'{channel}'/$channel}"
    jq -e '(.tag | type == "string" and test("^[0-9A-Za-z._-]+$")) and (.files | length > 0)' \
        "${manifest}.part" >/dev/null
    jq -r '.files[] | "\(.sha1)  \(.name)"' "${manifest}.part" >"${manifest}.list"
    valid_list "${manifest}.list"
    mv -f "${manifest}.part" "$manifest"
}

# A list of a version: a line per file, each as SUM_LINE has it.
valid_list() {
    if grep -qvE "$SUM_LINE" "$1"; then
        echo "${1##*/} has a line that is no sha1 and file name" >&2
        return 1
    fi
}

update_mxl() {
    if ! ui_progress "Downloading Median XL $1" store_version "$1"; then
        ui_error "Median XL $1 could not be downloaded.\n\n$(log_hint)"
        return 1
    fi
    apply_version "$1" && prune_store
}

# Brings a version into the store: its list, and each file the store lacks. A
# file the game holds already is copied from there, any other is downloaded,
# and each is checked against its sha1.
store_version() {
    local tag="$1" manifest="${run}/manifest.json" sum name url file n=0 total
    mkdir -p "${patches}/files"
    total="$(jq '.files | length' "$manifest")"
    while IFS=$'\t' read -r sum name url; do
        n=$((n + 1))
        file="${patches}/files/${sum}"
        [[ ! -f $file ]] || continue
        if [[ -f ${game}/${name} && "$(sha1 "${game}/${name}")" == "$sum" ]]; then
            cp --reflink=auto "${game}/${name}" "${file}.part"
        else
            echo "# Downloading ${name}, file ${n} of ${total}"
            fetch -o "${file}.part" "$url"
        fi
        if [[ "$(sha1 "${file}.part")" != "$sum" ]]; then
            echo "${name} does not match its sha1 ${sum}" >&2
            return 1
        fi
        mv -f "${file}.part" "$file"
    done < <(jq -r '.files[] | [.sha1, .name, .url] | @tsv' "$manifest")
    jq -r '.files[] | "\(.sha1)  \(.name)"' "$manifest" >"${patches}/${tag}.sha1.part"
    mv -f "${patches}/${tag}.sha1.part" "${patches}/${tag}.sha1"
}

sha1() {
    local line
    line="$(sha1sum "$1")"
    printf '%s' "${line%% *}"
}

# Puts a version from the store into the game. A file that differs from what the
# last update put there is yours: it stays unless you replace it.
apply_version() {
    local tag="$1" answer keep=()
    mapfile -t keep < <(changed_files | grep -Fxf <(cut -c43- "${patches}/${tag}.sha1") || true)
    if ((${#keep[@]})); then
        answer="$(ui_ask "You changed these files since Median XL $(installed_tag):\n\n<tt>$(esc "$(printf '%s\n' "${keep[@]}")")</tt>\n\nKeep them?" \
            --ok-label='Keep Mine' --extra-button=Replace --cancel-label=Cancel)" && answer=Keep || true
        case $answer in
        Keep) ;;
        Replace) keep=() ;;
        *) return 1 ;;
        esac
    fi
    if ! ui_progress --no-cancel "Installing Median XL ${tag}" install_version "$tag" "${keep[@]}"; then
        ui_error "Median XL ${tag} could not be installed.\n\n$(log_hint)"
        return 1
    fi
    notify "Median XL ${tag} is installed."
}

# The files of the last update that differ now, one per line.
changed_files() {
    [[ -f ${game}/d2launcher-patch.sha1 ]] || return 0
    (cd "$game" && LC_ALL=C sha1sum -c --quiet d2launcher-patch.sha1 2>/dev/null || true) |
        sed -n 's/: FAILED$//p'
}

install_version() {
    local tag="$1" list="${patches}/$1.sha1" sum name
    local -A keep=() changed=() differ=()
    shift
    for name; do keep[$name]=1; done
    while IFS= read -r name; do changed[$name]=1; done < <(changed_files)
    cd "$game"
    while IFS= read -r name; do differ[$name]=1; done < <(
        LC_ALL=C sha1sum -c --quiet "$list" 2>/dev/null | sed -n 's/: FAILED\( open or read\)\{0,1\}$//p' || true
    )
    while read -r sum name; do
        [[ -n ${differ[$name]:-} && -z ${keep[$name]:-} ]] || continue
        cp --reflink=auto "${patches}/files/${sum}" "${name}.part"
        mv -f "${name}.part" "$name"
    done <"$list"
    # What the last version brought and this one does not goes, unless it is yours.
    if [[ -f d2launcher-patch.sha1 ]]; then
        while IFS= read -r name; do
            [[ -n ${changed[$name]:-} ]] || rm -f -- "$name"
        done < <(comm -23 <(cut -c43- d2launcher-patch.sha1 | sort) <(cut -c43- "$list" | sort))
    fi
    # Read back: each file the update wrote is the one the list names.
    while read -r sum name; do
        [[ -n ${keep[$name]:-} ]] || printf '%s  %s\n' "$sum" "$name"
    done <"$list" | LC_ALL=C sha1sum -c --quiet
    cp "$list" d2launcher-patch.sha1.part
    mv -f d2launcher-patch.sha1.part d2launcher-patch.sha1
    printf '%s\n' "$tag" >d2launcher-patch.version.part
    mv -f d2launcher-patch.version.part d2launcher-patch.version
}

# The versions in the store, newest first.
versions() {
    local list
    for list in "${patches}"/*.sha1; do
        list="${list##*/}"
        printf '%s\n' "${list%.sha1}"
    done | sort -rV
}

# The three newest versions stay in the store, and the installed one, each with
# its files.
prune_store() {
    local tag installed name n=0
    installed="$(installed_tag)"
    while IFS= read -r tag; do
        n=$((n + 1))
        ((n <= 3)) || [[ $tag == "$installed" ]] || rm -f "${patches}/${tag}.sha1"
    done < <(versions)
    while IFS= read -r name; do
        rm -f "${patches}/files/${name}"
    done < <(comm -23 <(find "${patches}/files" -type f -printf '%f\n' | sort) \
        <(cat "${patches}"/*.sha1 /dev/null | cut -c1-40 | sort -u))
}

choose_version() {
    local tag installed choice rows=()
    ready_game || return 0
    installed="$(installed_tag)"
    while IFS= read -r tag; do
        if [[ $tag == "$installed" ]]; then
            rows+=(TRUE "$tag" installed)
        else
            rows+=(FALSE "$tag" '')
        fi
    done < <(versions)
    if ((${#rows[@]} == 0)); then
        ui_info 'No Median XL version is stored yet. Check for an update first.'
        return 0
    fi
    choice="$(ui_list '' --radiolist --column='Choose Version' --column='' --ok-label=Install --cancel-label=Back "${rows[@]}")" ||
        return 0
    [[ $choice != "$installed" ]] || ui_ask "Median XL ${choice} is installed. Install it again?" || return 0
    apply_version "$choice" || true
}

# --- D2Stats

ready_d2stats() {
    [[ ! -f ${stats}/D2Stats.exe ]] || return 0
    ui_progress 'Downloading D2Stats' install_d2stats && return 0
    ui_error "D2Stats could not be installed.\n\n$(log_hint)"
    return 1
}

# The newest D2Stats, with its settings, notifier rules and sounds kept.
install_d2stats() {
    local part="${stats}.part" zip="${run}/D2Stats.zip" item
    fetch -o "$zip" "$D2STATS_URL"
    rm -rf "$part"
    mkdir -p "$part"
    unzip -q "$zip" -d "$part"
    for item in D2Stats.exe.ini NotifierRules Sounds; do
        [[ -e ${stats}/${item} ]] || continue
        rm -rf "${part:?}/${item}"
        cp -a "${stats}/${item}" "$part/"
    done
    rm -rf "${stats}.old" "$zip"
    [[ ! -d $stats ]] || mv "$stats" "${stats}.old"
    mv "$part" "$stats"
    rm -rf "${stats}.old"
}

ready_sigma_loader() {
    [[ ! -f ${game}/sigma-loader.exe ]] || return 0
    ui_progress 'Downloading sigma-loader' fetch_file "$SIGMA_LOADER_URL" "${game}/sigma-loader.exe" && return 0
    ui_error "sigma-loader could not be downloaded.\n\n$(log_hint)"
    return 1
}

# D2Stats, waited for up to 30 seconds, as the game has to start after it.
start_d2stats() {
    local _
    pgrep -x D2Stats.exe >/dev/null && return 0
    (cd "$stats" && with_wine "$wine" D2Stats.exe 2>&1 | log_stream d2stats) </dev/null 9>&- &
    for _ in {1..60}; do
        pgrep -x D2Stats.exe >/dev/null && return 0
        sleep 0.5
    done
    ui_error "D2Stats did not start within 30 seconds.\n\n$(log_hint)"
    return 1
}

update_d2stats() {
    ui_ask 'Update D2Stats and sigma-loader to their newest releases? Your D2Stats settings, notifier rules and sounds stay.' \
        --ok-label=Update --cancel-label=Cancel || return 0
    ready_game || return 0
    if ! ui_progress 'Downloading D2Stats' install_d2stats ||
        ! ui_progress 'Downloading sigma-loader' fetch_file "$SIGMA_LOADER_URL" "${game}/sigma-loader.exe"; then
        ui_error "D2Stats could not be installed.\n\n$(log_hint)"
        return 0
    fi
    notify 'D2Stats is installed.'
}

# --- Tweaks

# The tweaks D2Launcher brings and yours in ~/.d2launcher/tweaks, a script each.
# Yours win over one of the same name. A tweak shows its script before it runs,
# and what it printed last after.
tweaks_menu() {
    local -A path=()
    local file name rows=() choice output status
    for file in "${dir}"/tweaks/*.sh "${user_tweaks}"/*.sh; do
        name="${file##*/}"
        path[${name%.sh}]="$file"
    done
    while IFS= read -r name; do
        [[ -n $name ]] || continue
        rows+=("$name" "$(sed -n '2s/^# //p' "${path[$name]}")")
    done < <(printf '%s\n' "${!path[@]}" | sort)
    while true; do
        choice="$(ui_list Tweaks --width=600 --column='' --ok-label=Ok --cancel-label=Back --extra-button='?' "${rows[@]}")" ||
            true
        case $choice in
        '') return 0 ;;
        '?')
            open_docs
            continue
            ;;
        esac
        ui_text "$choice" --filename="${path[$choice]}" --ok-label=Install --cancel-label=Back >/dev/null || continue
        ready_game || continue
        status=0
        run_tweak "$choice" "${path[$choice]}" || status=$?
        output="$(tail -n 12 "${run}/tweak/tweak.log")"
        output="${output:+\n\n<tt>$(esc "$output")</tt>}"
        if ((status == 0)); then
            ui_info "${choice} is installed.${output}"
        else
            ui_error "${choice} failed with status ${status}.${output}\n\n$(log_hint)"
        fi
    done
}

# A tweak runs in a folder of its own and finds the game in D2_DIR, the place for
# its downloads in D2_CACHE. What it prints is in its folder as tweak.log.
run_tweak() {
    local work="${run}/tweak"
    rm -rf "$work"
    mkdir -p "$work" "${cache}/tweaks"
    ui_progress "Installing $1" tweak_job "$2" "$work"
}

# What a tweak prints goes into tweak.log and into the log.
tweak_job() {
    (cd "$2" && D2_DIR="$game" D2_CACHE="${cache}/tweaks" WINEPREFIX="$prefix" bash "$1") 2>&1 |
        tee "$2/tweak.log" | log_stream tweak
}

# --- Backups and savegames

# The backup of the game folder, named after it.
game_backup() {
    printf '%s/%s.tar' "$backups" "${game##*/}"
}

backup_game() {
    mkdir -p "$backups"
    tar -cf "$(game_backup).part" -C "${game%/*}" "${game##*/}"
    mv -f "$(game_backup).part" "$(game_backup)"
}

# The backup in a folder of its own first, then in place of the game. The saves
# Diablo II before 1.14 keeps in the game folder stay.
restore_game() {
    local into="${game%/*}/restore"
    rm -rf "$into" "${game}.old"
    mkdir -p "$into"
    tar -xf "$(game_backup)" -C "$into"
    [[ ! -d $game ]] || mv "$game" "${game}.old"
    mv "${into}/${game##*/}" "$game"
    if [[ -d ${game}.old/save ]]; then
        rm -rf "${game}/save"
        mv "${game}.old/save" "${game}/save"
    fi
    rm -rf "${game}.old" "$into"
}

create_backup() {
    ready_game || return 0
    if ! ui_progress 'Backing up Diablo II' backup_game; then
        ui_error "The backup failed.\n\n$(log_hint)"
        return 0
    fi
    notify 'Diablo II is backed up.'
}

restore_backup() {
    local when
    when="$(date -r "$(game_backup)" '+%F %R')"
    ui_ask "Restore the backup of ${when}?\n\nIt replaces the Diablo II folder, the saves stay. What else changed since then is lost." \
        --ok-label=Restore --cancel-label=Cancel --default-cancel || return 0
    if ! ui_progress --no-cancel 'Restoring Diablo II' restore_game; then
        ui_error "The backup could not be restored.\n\n$(log_hint)"
        return 0
    fi
    notify 'Diablo II is restored.'
}

# The savegames as a zip: for an export, and in the backup folder before
# something could change them.
zip_saves() {
    mkdir -p "${1%/*}"
    (cd "$(saves)" && zip -qr0 "$1" .)
}

# The name of a saves zip, by the game it is for.
saves_name() {
    if [[ $median_xl == true ]]; then
        printf d2launcher-mxl-save
    else
        printf d2launcher-diablo2-save
    fi
}

saves_backup() {
    printf '%s/%s-%(%Y-%m-%d-%H%M%S)T.zip' "$backups" "$(saves_name)" -1
}

export_saves() {
    local folder file
    ready_wine || return 0
    folder="$(ui --file-selection --directory)" || return 0
    file="${folder}/$(saves_name)-$(date '+%Y-%m-%d-%H%M').zip"
    if ! zip_saves "$file"; then
        ui_error "The saves could not be exported.\n\n$(log_hint)"
        return 0
    fi
    ui_info "Your saves are in\n$(esc "$file")"
}

# Imported savegames replace those of the same name. Those go into the backup
# folder first.
import_saves() {
    local file saved
    ready_wine || return 0
    file="$(ui --file-selection --file-filter="Saves | $(saves_name)-*.zip")" || return 0
    if ! unzip -tq "$file" >/dev/null; then
        ui_error "$(esc "$file") is no readable zip."
        return 0
    fi
    saved="$(saves_backup)"
    if ! zip_saves "$saved" || ! unzip -qo "$file" -d "$(saves)"; then
        ui_error "The saves could not be imported.\n\n$(log_hint)"
        return 0
    fi
    ui_info "Your saves are imported. Those you had are in\n$(esc "$saved")"
}

# --- D2Launcher itself

# The version a release stamped. Unstamped, a checkout is a pre-release of the
# patch after its last release tag, and anything else is unknown.
version() {
    local last
    if [[ $VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then
        printf '%s\n' "$VERSION"
    elif [[ -e ${dir}/.git ]] && last="$(git -C "$dir" describe --tags --abbrev=0 \
        --match '[0-9]*.[0-9]*.[0-9]*' --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null)"; then
        last="${last#v}"
        printf '%s.%s-dev\n' "${last%.*}" "$((${last##*.} + 1))"
    else
        echo unknown
    fi
}

# Every request leaving the machine, bound to https, redirects included. A
# transfer slower than 1 kB/s for a minute ends.
fetch() {
    curl --proto '=https' --proto-redir '=https' --tlsv1.2 -fsSL --connect-timeout 10 \
        --speed-limit 1024 --speed-time 60 "$@"
}

# A download into a file, whole or not at all.
fetch_file() {
    fetch -o "$2.part" "$1"
    mv -f "$2.part" "$2"
}

# The newest release as tag, download and sha256, separated by tabs.
fetch_release() {
    fetch --max-time 30 "$RELEASE_URL" | jq -er '.tag_name as $tag | .assets[]
        | select(.name == "d2launcher-\($tag).tar.gz") | [$tag, .browser_download_url, (.digest // "")] | @tsv' \
        >"${run}/release.part"
    mv -f "${run}/release.part" "${run}/release"
}

# A copy unpacked by hand: its folder is the user's. A package manager installs
# into one that is not, and a checkout belongs to git.
portable() {
    [[ -w $dir && ! -e ${dir}/.git ]]
}

# A copy unpacked by hand updates itself. The package manager or git update the
# others, so their menu has no entry for it.
update_launcher() {
    local latest url digest
    if ! ui_progress 'Checking for D2Launcher updates' fetch_release; then
        ui_error "The newest release cannot be read.\n\n$(log_hint)"
        return 0
    fi
    IFS=$'\t' read -r latest url digest <"${run}/release"
    if [[ $latest == "$(version)" ]]; then
        ui_ask "D2Launcher ${latest} is up to date. Install it again?" --ok-label=Install --cancel-label=Cancel || return 0
    else
        ui_ask "D2Launcher ${latest} is available." --ok-label=Update --cancel-label=Later || return 0
    fi
    if ! ui_progress --no-cancel "Installing D2Launcher ${latest}" install_release "$latest" "$url" "$digest"; then
        ui_error "D2Launcher ${latest} could not be installed.\n\n$(log_hint)"
        return 0
    fi
    ui_info "D2Launcher ${latest} is installed and starts again."
    rm -rf "$run"
    exec "${dir}/d2launcher"
}

# Unpacked beside this copy, read back, then file by file renamed into place: the
# running script keeps reading the file it opened.
install_release() {
    local work file
    work="$(mktemp -d "${dir}/.update.XXXXXX")"
    fetch -o "${work}/release.tar.gz" "$2"
    [[ -z $3 ]] || printf '%s  %s\n' "${3#sha256:}" "${work}/release.tar.gz" | LC_ALL=C sha256sum -c --quiet
    mkdir "${work}/new"
    tar -xzf "${work}/release.tar.gz" -C "${work}/new" --strip-components=1
    [[ "$(bash "${work}/new/d2launcher" --version)" == "$1" ]]
    [[ -d ${work}/new/tweaks ]]
    while IFS= read -r file; do
        mv -f "${work}/new/${file}" "${dir}/${file}"
    done < <(find "${work}/new" -maxdepth 1 -type f -printf '%f\n')
    [[ ! -d ${dir}/tweaks ]] || mv "${dir}/tweaks" "${work}/old"
    mv "${work}/new/tweaks" "${dir}/tweaks"
    rm -rf "$work"
}

# At the start of a copy unpacked by hand: a notification when a newer release
# is out.
notify_update() {
    local latest
    portable || return 0
    fetch_release 2> >(log_stream launcher) || return 0
    latest="$(cut -f1 "${run}/release")"
    [[ $latest == "$(version)" ]] || notify "D2Launcher ${latest} is available. Settings has Update D2Launcher."
}

# A copy unpacked by hand gets a menu entry of its own, pointing here. Otherwise
# the package brings one, and the entry of a former copy goes.
menu_entry() {
    local entry="${XDG_DATA_HOME:-${HOME}/.local/share}/applications/d2launcher.local.desktop" line want=''
    if ! portable; then
        rm -f "$entry"
        return 0
    fi
    while IFS= read -r line; do
        case $line in
        Exec=*) line="Exec=\"${dir}/d2launcher\"" ;;
        Icon=*) line="Icon=${icon}" ;;
        esac
        want+="${line}"$'\n'
    done <"${dir}/d2launcher.desktop"
    [[ ! -f $entry || "$(<"$entry")"$'\n' != "$want" ]] || return 0
    mkdir -p "${entry%/*}"
    printf '%s' "$want" >"${entry}.part"
    mv -f "${entry}.part" "$entry"
}

