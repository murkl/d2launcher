# cnc-ddraw Settings with its program in the game folder.
tools_menu() {
    local choice items
    while true; do
        items=('Wine Configuration')
        [[ ! -f "${game}/cnc-ddraw config.exe" ]] || items+=('cnc-ddraw Settings')
        items+=('Run Program' 'Reinstall Wine')
        choice="$(ui_menu Tools Back "${items[@]}")" || true
        case $choice in
        'Wine Configuration') ready_wine && run_wine winecfg || true ;;
        'cnc-ddraw Settings') ready_wine && (cd "$game" && run_wine 'cnc-ddraw config.exe') || true ;;
        'Run Program') run_program ;;
        'Reinstall Wine') reinstall_wine ;;
        '?') open_docs ;;
        *) return 0 ;;
        esac
    done
}

# Restore Backup only when there is a backup.
backups_menu() {
    local choice items
    while true; do
        items=('Create Backup')
        [[ ! -f $(game_backup) ]] || items+=('Restore Backup')
        items+=('Export Saves' 'Import Saves')
        choice="$(ui_menu Backups Back "${items[@]}")" || true
        case $choice in
        'Create Backup') create_backup ;;
        'Restore Backup') restore_backup ;;
        'Export Saves') export_saves ;;
        'Import Saves') import_saves ;;
        '?') open_docs ;;
        *) return 0 ;;
        esac
    done
}

# --- Migration

# What older versions left, brought into today's form. Each step reads what is
# there, so a second run changes nothing.
migrate() {
    migrate_portable
    migrate_menu_entry
    migrate_settings
    migrate_tweaks
    migrate_patches
}

# Before 4.0 the data lay beside the script, and 4.x copies kept res/ there.
migrate_portable() {
    local from to
    portable || return 0
    while read -r from to; do
        [[ -e ${dir}/${from} && ! -e ${home}/${to} ]] || continue
        mkdir -p "$(dirname "${home}/${to}")"
        mv "${dir}/${from}" "${home}/${to}"
        log "Moved ${dir}/${from} to ${home}/${to}"
    done <<'EOF'
d2launcher.conf d2launcher.conf
.wineprefix wineprefix
res/patches patches
res/wine64 bin/wine
res/d2-stats bin/d2-stats
EOF
    [[ ! -f ${dir}/res/d2-patch.zip ]] || rm -rf "${dir}/res"
}

# 4.0 named the menu entry of a copy d2launcher.desktop, the name of the package's.
migrate_menu_entry() {
    local entry="${XDG_DATA_HOME:-${HOME}/.local/share}/applications/d2launcher.desktop"
    [[ -f $entry ]] && grep -q '^StartupWMClass=zenity$' "$entry" && rm -f "$entry" || true
}

# 4.x kept its settings as shell code, read with source, and wrote some of them
# into every file. It is read that way one last time, in a shell of its own,
# and kept as d2launcher.conf.bak.
migrate_settings() {
    local values=() options=() words=() line problem
    [[ -f $conf ]] && grep -qE '^[[:space:]]*(d2_exe|d2_args|update_check|mxl_update_check|gui_width)=' "$conf" ||
        return 0
    # A file with a setting of today, set or commented out, has its form already.
    # A 4.x start in between appended its defaults, and they go.
    if grep -qE '^[[:space:]]*#?(launch_options|channel|wine|prefix)=' "$conf"; then
        drop_4x_defaults
        return 0
    fi
    # shellcheck disable=SC2016  # the old settings expand in the shell that reads them
    mapfile -d '' values < <(env -i HOME="$HOME" USER="${USER:-}" PATH="$PATH" bash -c 'source "$1" >/dev/null 2>&1
        printf "%s\0" "${d2_args-}" "${wine_init-}" "${custom_command-}" "${mxl_update_channel-}" \
            "${wine_default-}" "${wineprefix-}" "${d2_exe-Diablo II.exe}"
        env -0 -u HOME -u USER -u PATH -u PWD -u SHLVL -u _ -u OLDPWD' _ "$conf")
    # Exported variables reached the game. Now they stand in front of it.
    for line in "${values[@]:7}"; do
        if [[ $line == *[[:space:]]* ]]; then
            log "Settings: export ${line} holds a space and is left out"
        else
            options+=("$line")
        fi
    done
    # custom_command replaced the game, wine_init stood in front of it.
    if [[ -n ${values[2]} ]]; then
        read -ra words <<<"${values[2]}"
        options+=("${words[@]}" '%command%')
    else
        read -ra words <<<"${values[1]}"
        options+=("${words[@]}")
        ((${#options[@]} == 0)) || options+=('%command%')
        read -ra words <<<"${values[0]}"
        options+=("${words[@]}")
    fi
    settings_template >"${conf}.new"
    set_setting "${conf}.new" launch_options "${options[*]}" -3dfx
    set_setting "${conf}.new" channel "${values[3]}" public
    set_setting "${conf}.new" wine "${values[4]}" "${wine_home}/bin/wine"
    set_setting "${conf}.new" prefix "${values[5]}" "${home}/wineprefix"
    problem="$(defaults && read_settings "${conf}.new")" || log "Settings: the new file says: ${problem}"
    [[ ${values[6]} == 'Diablo II.exe' ]] || log "Settings: d2_exe=${values[6]} is gone, the game starts Diablo II.exe"
    mv -f "$conf" "${conf}.bak"
    mv -f "${conf}.new" "$conf"
    notify "Your settings have a new form. The old ones are in ${conf}.bak."
}

# The settings 4.x appends to a file that lacks them, each a line of its own.
drop_4x_defaults() {
    local line kept=''
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line =~ ^(d2_exe|d2_args|gui_width|gui_height|update_check|mxl_update_check|mxl_update_channel|d2_stats_tray)= ]]; then
            log "Settings: ${line} goes, D2Launcher 4.x appended it"
        else
            kept+="${line}"$'\n'
        fi
    done <"$conf"
    printf '%s' "$kept" >"${conf}.part"
    mv -f "${conf}.part" "$conf"
}

# Sets a setting in a file from settings_template, unless it is the default.
set_setting() {
    local file="$1" key="$2" value="$3" default="$4" line text=''
    [[ -n $value && $value != "$default" ]] || return 0
    while IFS= read -r line; do
        [[ $line != "${key}="* ]] || line="${key}=${value}"
        text+="${line}"$'\n'
    done <"$file"
    printf '%s' "$text" >"$file"
}

# 4.x kept the tweaks in tweaks.db, between ###!> tweak_name lines. The two it
# brought come with D2Launcher now, any other becomes a script of its own.
migrate_tweaks() {
    local db="${home}/tweaks.db" name='' body='' line file
    [[ -f $db ]] || return 0
    mkdir -p "$user_tweaks" "${cache}/tweaks" "$backups"
    # 4.x downloaded beside the tweaks.
    for file in "${user_tweaks}"/*.zip; do
        mv -f "$file" "${cache}/tweaks/"
    done
    while IFS= read -r line || [[ -n $line ]]; do
        case $line in
        '###!> tweak_name: '*)
            save_tweak "$name" "$body"
            name="${line#'###!> tweak_name: '}"
            body=''
            ;;
        '###!> tweak_version: '*) ;;
        *) body+="${line}"$'\n' ;;
        esac
    done <"$db"
    save_tweak "$name" "$body"
    mv -f "$db" "${backups}/tweaks.db"
}

save_tweak() {
    local name="$1" file
    case $name in
    '' | GavinK88/d2gl-mxl-1.0 | FunkyFr3sh/cnc-ddraw) return 0 ;;
    esac
    file="${name//[^[:alnum:]._-]/_}"
    printf '#!/usr/bin/env bash\n# %s, from tweaks.db\n%s' "$name" "$2" >"${user_tweaks}/${file}.sh"
    log "Tweaks: ${name} is now ${user_tweaks}/${file}.sh"
}

# 4.x kept each Median XL version as a zip of all its files. They move into the
# store, each file once, and the installed version gets the list a later update
# compares with.
migrate_patches() {
    local zip tag
    for zip in "${patches}"/d2launcher-mxl-*.zip; do
        tag="${zip##*/d2launcher-mxl-}"
        tag="${tag%.zip}"
        if ! ui_progress --no-cancel "Moving Median XL ${tag} into the new store" store_zip "$zip" "$tag"; then
            ui_error "Median XL ${tag} could not move into the new store.\n\n$(log_hint)"
            return 0
        fi
    done
    tag="$(installed_tag)"
    if [[ -n $tag && ! -f ${game}/d2launcher-patch.sha1 && -f ${patches}/${tag}.sha1 ]]; then
        cp "${patches}/${tag}.sha1" "${game}/d2launcher-patch.sha1"
    fi
}

store_zip() {
    local zip="$1" tag="$2" work sum name
    rm -rf "${patches}"/tmp.*
    work="$(mktemp -d -p "$patches")"
    mkdir -p "${patches}/files"
    unzip -q "$zip" -d "$work"
    (cd "$work" && find . -type f -printf '%P\0' | sort -z | xargs -0 -r sha1sum) >"${work}.sha1"
    valid_list "${work}.sha1"
    while read -r sum name; do
        [[ -f ${patches}/files/${sum} ]] || mv "${work}/${name}" "${patches}/files/${sum}"
    done <"${work}.sha1"
    mv -f "${work}.sha1" "${patches}/${tag}.sha1"
    rm -rf "$work" "$zip"
}

# --- Start

# An unexpected failure. The launcher shows the command and stops, a job writes it
# to the log, which the launcher then points to.
failed() {
    log "Failed with status $1 at line $2: $3"
    if [[ $BASHPID == "$$" ]]; then
        ui_error "D2Launcher stopped at line $2:\n\n<tt>$(esc "$3")</tt>\n\n$(log_hint)"
    fi
    exit "$1"
}

check_requirements() {
    local command missing=() text
    for command in "${REQUIRES[@]}"; do
        command -v "$command" >/dev/null || missing+=("$command")
    done
    ((${#missing[@]})) || return 0
    text="D2Launcher needs ${missing[*]}. Your package manager installs them."
    echo "$text" >&2
    ui_error "$text" 2>/dev/null
    exit 1
}

main() {
    set -Eeuo pipefail
    shopt -s inherit_errexit nullglob
    places
    case ${1:-} in
    --version)
        version
        return 0
        ;;
    '') ;;
    *)
        echo 'usage: d2launcher [--version]' >&2
        return 2
        ;;
    esac
    icon_option=()
    check_requirements
    [[ "$(zenity --version 2>/dev/null)" != [4-9]* ]] || icon_option=(--icon="$icon")
    mkdir -p "$home" "$backups" "$cache"
    exec 9>"${home}/d2launcher.lock"
    if ! flock -n 9; then
        ui --notification --text='D2Launcher is running already.' >/dev/null 2>&1 9>&- &
        return 0
    fi
    rotate_logs
    trap 'failed $? "$LINENO" "$BASH_COMMAND"' ERR
    run="$(mktemp -d -p "$cache" run.XXXXXX)"
    trap 'rm -rf "$run"' EXIT
    log_system
    migrate
    load_settings
    log "Settings: launch_options=${launch_options} channel=${channel} wine=${wine} prefix=${prefix} median_xl=${median_xl} d2stats=${d2stats}"
    menu_entry
    notify_update 9>&- &
    # A first start sets everything up, so the menu opens ready to play.
    [[ -d $game ]] || ready || true
    main_menu
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
