        esac
    done
}

mxl_menu() {
    local choice
    while true; do
        choice="$(ui_menu 'Median XL' Back 'Check for Updates' 'Choose Version')" || true
        case $choice in
        'Check for Updates') check_mxl ;;
        'Choose Version') choose_version ;;
        '?') open_docs ;;
        *) return 0 ;;
        esac
